+// Materialize one zero-filled lazy heap page when kernel copyout targets it.
+int
+lazyalloc(pde_t *pgdir, uint va, uint sz)
+{
+  struct proc *p = myproc();
+  char *mem;
+  uint a = PGROUNDDOWN(va);
+  pte_t *pte;
+
+  if(p == 0 || p->pgdir != pgdir || a < p->heapbase || a >= sz || a >= KERNBASE)
+    return -1;
+  pte = walkpgdir(pgdir, (char*)a, 0);
+  if(pte && (*pte & PTE_P))
+    return -1;
+  if((mem = kalloc()) == 0)
+    return -1;
+  memset(mem, 0, PGSIZE);
+  if(mappages(pgdir, (char*)a, PGSIZE, V2P(mem), PTE_W|PTE_U) < 0){
+    kfree(mem);
+    return -1;
+  }
+  return 0;
+}
