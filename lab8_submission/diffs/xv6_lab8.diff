+// Snapshot free and total pages while holding the allocator lock.
+void
+memstats(int *freep, int *totalp)
+{
+  acquire(&kmem.lock);
+  *freep = kmem.free_pages;
+  *totalp = kmem.total_pages;
+  release(&kmem.lock);
+}
