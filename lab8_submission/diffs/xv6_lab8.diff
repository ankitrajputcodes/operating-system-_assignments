+int
+sys_va2pa(void)
+{
+  int va;
+  pte_t *pte;
+  uint pa, flags;
+
+  if(argint(0, &va) < 0 || (uint)va >= KERNBASE)
+    return -1;
+  pte = walkpgdir(myproc()->pgdir, (void*)va, 0);
+  if(pte == 0 || !(*pte & PTE_P) || !(*pte & PTE_U))
+    return -1;
+  flags = PTE_FLAGS(*pte);
+  pa = PTE_ADDR(*pte) + ((uint)va & (PGSIZE - 1));
+  cprintf("va2pa va=0x%x pdi=%d pti=%d off=0x%x pa=0x%x P=%d W=%d U=%d\n",
+          va, PDX(va), PTX(va), (uint)va & (PGSIZE-1), pa,
+          !!(flags & PTE_P), !!(flags & PTE_W), !!(flags & PTE_U));
+  return (int)pa;
+}
+
+int
+sys_vmprint(void)
+{
+  int i, j, kernel_entries = 0;
+  pde_t *pgdir = myproc()->pgdir;
+  pte_t *pt;
+  uint va;
+
+  for(i = 0; i < NPDENTRIES; i++){
+    if(i >= PDX(KERNBASE)){
+      if(pgdir[i] & PTE_P)
+        kernel_entries++;
+      continue;
+    }
+    if(!(pgdir[i] & PTE_P))
+      continue;
+    cprintf("PDE %d: pt_pa=0x%x flags=0x%x\n", i,
+            PTE_ADDR(pgdir[i]), PTE_FLAGS(pgdir[i]));
+    pt = (pte_t*)P2V(PTE_ADDR(pgdir[i]));
+    for(j = 0; j < NPTENTRIES; j++){
+      if(!(pt[j] & PTE_P))
+        continue;
+      va = PGADDR(i, j, 0);
+      cprintf("  PTE %d: va=0x%x pa=0x%x P=%d W=%d U=%d\n", j, va,
+              PTE_ADDR(pt[j]), !!(pt[j]&PTE_P), !!(pt[j]&PTE_W), !!(pt[j]&PTE_U));
+    }
+  }
+  cprintf("kernel PDE entries: %d\n", kernel_entries);
+  return 0;
+}
+
+int
+sys_getmeminfo(void)
+{
+  char *u;
+  struct meminfo *mi;
+  struct proc *p = myproc();
+  int i, ptpages = 1;
+
+  if(argptr(0, &u, sizeof(*mi)) < 0)
+    return -1;
+  mi = (struct meminfo*)u;
+  for(i = 0; i < NPDENTRIES; i++)
+    if(p->pgdir[i] & PTE_P)
+      ptpages++;
+  memstats(&mi->free_pages, &mi->total_pages);
+  mi->process_pages = p->sz / PGSIZE;
+  mi->page_table_pages = ptpages;
+  return 0;
+}
