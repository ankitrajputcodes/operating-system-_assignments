+#define SYS_vtop      27
diff --git a/sysproc.c b/sysproc.c
index fe8b1d8..36628fb 100644
--- a/sysproc.c
+++ b/sysproc.c
@@ -127 +127 @@ sys_getmeminfo(void)
-  memstats(&mi->free_pages, &mi->total_pages);
+  kallocstats(&mi->free_pages, &mi->total_pages);
@@ -132,0 +133,23 @@ sys_getmeminfo(void)
+int
+sys_memstats(void)
+{
+  int allocated, freed, current, available;
+  kalloccounters(&allocated, &freed, &current, &available);
+  cprintf("allocated pages: %d\nfreed pages: %d\ncurrently allocated pages: %d\navailable physical pages: %d\n",
+          allocated, freed, current, available);
+  return 0;
+}
+
+int
+sys_vtop(void)
+{
+  int va;
+  pte_t *pte;
+  if(argint(0, &va) < 0 || (uint)va >= KERNBASE)
+    return -1;
+  pte = walkpgdir(myproc()->pgdir, (void*)va, 0);
+  if(pte == 0 || !(*pte & PTE_P) || !(*pte & PTE_U))
+    return -1;
+  return (int)(PTE_ADDR(*pte) + ((uint)va & (PGSIZE - 1)));
+}
+
