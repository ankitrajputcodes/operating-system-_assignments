@@ -106 +111 @@ void
-memstats(int *freep, int *totalp)
+kallocstats(int *freep, int *totalp)
@@ -112,0 +118,12 @@ memstats(int *freep, int *totalp)
+
+// Snapshot allocation counters and current free pages.
+void
+kalloccounters(int *allocatedp, int *freedp, int *currentp, int *availablep)
+{
+  acquire(&kmem.lock);
+  *allocatedp = kmem.allocated_pages;
+  *freedp = kmem.freed_pages;
+  *currentp = kmem.allocated_pages - kmem.freed_pages;
+  *availablep = kmem.free_pages;
+  release(&kmem.lock);
+}
diff --git a/memtest.c b/memtest.c
new file mode 100644
index 0000000..650b370
--- /dev/null
+++ b/memtest.c
@@ -0,0 +1,35 @@
+#include "types.h"
+#include "stat.h"
+#include "user.h"
+
+static void
+show(char *label)
+{
+  printf(1, "\n%s\n", label);
+  if(memstats() < 0)
+    printf(1, "memstats failed\n");
+}
+
+int
+main(void)
+{
+  char *p;
+
+  show("before allocation");
+  p = sbrk(4 * 4096);
+  if(p == (char*)-1){
+    printf(1, "sbrk allocation failed\n");
+    exit();
+  }
+  // Touch each page so the allocator supplies physical memory.
+  p[0] = 1;
+  p[4096] = 2;
+  p[2 * 4096] = 3;
+  p[3 * 4096] = 4;
+  show("after allocating and touching four pages");
+
+  if(sbrk(-4 * 4096) == (char*)-1)
+    printf(1, "sbrk release failed\n");
+  show("after releasing the four pages");
+  exit();
+}
